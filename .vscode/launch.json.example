{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "lldb",
			"request": "launch",
			"name": "Debug server",
			"cargo": {
				"args": ["build", "--profile", "server-dev", "--features", "server"]
			},
			"args": ["--devcert", "../../assets/devcert.json"],
			"cwd": "${workspaceFolder}/borger/server"
		}
	]
}
